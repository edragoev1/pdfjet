<?xml version="1.0" encoding="utf-8"?>
<!-- The NuGet package PDFjet.Fonts.CJK, made by package-nuget.sh: the CJK
     fonts PDFjet carries, IBM Plex Sans JP, KR, SC and TC, as resources of
     one assembly for .NET Standard 2.0, PDFjet.Fonts.CJK.dll, which PDFjet
     loads by its name; $version$ and $commit$ are written in by the
     script. -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>PDFjet.Fonts.CJK</id>
    <version>$version$</version>
    <title>PDFjet CJK fonts</title>
    <authors>PDFjet Software</authors>
    <license type="expression">OFL-1.1</license>
    <projectUrl>https://github.com/edragoev1/pdfjet</projectUrl>
    <repository type="git" url="https://github.com/edragoev1/pdfjet.git" commit="$commit$" />
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <description>The Chinese, Japanese and Korean fonts of PDFjet, IBM Plex Sans JP, KR, SC and TC, Regular, SemiBold and Bold, under the SIL Open Font License 1.1, for the package PDFjet of the same version: add it next to PDFjet, and constants such as IBMPlexSansJP.Regular work. No code. For .NET 8 and later and .NET Framework 4.8.</description>
    <releaseNotes>https://github.com/edragoev1/pdfjet/blob/main/CHANGELOG.md</releaseNotes>
    <copyright>Copyright (c) 2017 IBM Corp. with Reserved Font Name "Plex"</copyright>
    <tags>pdfjet pdf fonts cjk chinese japanese korean ibm-plex</tags>
    <dependencies>
      <group targetFramework="netstandard2.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="lib/netstandard2.0/PDFjet.Fonts.CJK.dll" target="lib/netstandard2.0" />
    <file src="README.md" target="" />
    <file src="icon.png" target="" />
    <!-- The licenses of the fonts, one a family -->
    <file src="font-licenses/*" target="" />
  </files>
</package>
