<?xml version="1.0" encoding="utf-8"?>
<!-- The NuGet package PDFjet.HarfBuzz, made by package-nuget.sh: HarfBuzz for
     PDFjet's TextBlock and TextLine, through HarfBuzzSharp, whose packages bring
     HarfBuzz itself for Windows, Linux (glibc and musl) and macOS, x64 and
     arm64; one assembly for .NET Standard 2.0, PDFjet.HarfBuzz.dll, which
     PDFjet loads by its name; $version$ and $commit$ are written in by the
     script. -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>PDFjet.HarfBuzz</id>
    <version>$version$</version>
    <title>PDFjet HarfBuzz</title>
    <authors>PDFjet Software</authors>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/edragoev1/pdfjet</projectUrl>
    <repository type="git" url="https://github.com/edragoev1/pdfjet.git" commit="$commit$" />
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <description>HarfBuzz for PDFjet's TextBlock and TextLine, which draw Hindi, Bengali, Tamil, Telugu, Kannada, Malayalam, Gujarati, Punjabi, Odia, Sinhala, Khmer, Lao and Burmese: add it next to PDFjet, the same version, and TextBlock shapes with HarfBuzz on Windows, Linux and macOS, x64 and arm64, with nothing to install and no code. Through HarfBuzzSharp. For .NET 8 and later and .NET Framework 4.8.</description>
    <releaseNotes>https://github.com/edragoev1/pdfjet/blob/main/CHANGELOG.md</releaseNotes>
    <copyright>Copyright (c) 2026 PDFjet Software</copyright>
    <tags>pdfjet pdf harfbuzz text-shaping hindi indic khmer lao burmese complex-scripts</tags>
    <dependencies>
      <group targetFramework="netstandard2.0">
        <dependency id="HarfBuzzSharp" version="8.3.1.1" />
        <dependency id="HarfBuzzSharp.NativeAssets.Linux" version="8.3.1.1" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="lib/netstandard2.0/PDFjet.HarfBuzz.dll" target="lib/netstandard2.0" />
    <!-- Keeps the assembly, which PDFjet loads by its name, in a trimmed or
         NativeAOT app -->
    <file src="buildTransitive/PDFjet.HarfBuzz.props" target="buildTransitive" />
    <file src="README.md" target="" />
    <file src="icon.png" target="" />
  </files>
</package>
