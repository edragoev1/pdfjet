<Project Sdk="Microsoft.NET.Sdk">
  <!-- PDFjet.Fonts.World.dll, the assembly of the NuGet package
       PDFjet.Fonts.World (package-nuget.sh): the fonts PDFjet carries for
       every script but the European ones, IBM Plex Sans JP, KR, SC and TC,
       and IBM Plex Sans Arabic, Hebrew and Thai, the folders of
       resources/fonts/world, and their licenses, as resources and nothing
       else, named as in PDFjet.dll, PDFjet.Fonts/ and their path under
       resources/fonts, such as
       PDFjet.Fonts/world/IBMPlexSansJP/IBMPlexSansJP-Regular.otf. PDFjet
       loads it by its name when one of these fonts is asked for, and has no
       reference to it. For .NET Standard 2.0, so that one assembly serves
       .NET 8 and later and .NET Framework 4.8 alike, and the fonts are in
       the package once. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>library</OutputType>
    <AssemblyName>PDFjet.Fonts.World</AssemblyName>
    <RootNamespace>PDFjet.Fonts.World</RootNamespace>
    <AssemblyVersion>9.0.0.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>PDFjet Software</Company>
    <Product>PDFjet</Product>
    <Copyright>Copyright (c) 2026 PDFjet Software</Copyright>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../resources/fonts/world/*/*.otf;../../resources/fonts/world/*/*.ttf;../../resources/fonts/world/*/license.txt" LogicalName="PDFjet.Fonts/world/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
