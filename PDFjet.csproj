<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- The version of the assembly, its identity with its strong name, is the
         same through 9.x, so that clients need no binding redirects; the
         release, 9.0.3, is its file version, which package-dotnet.sh sets.
         package-dotnet.sh also signs it with the strong-name key, which is
         not in the repository: PDFJET_SNK. -->
    <AssemblyVersion>9.0.0.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>PDFjet Software</Company>
    <Product>PDFjet</Product>
    <Copyright>Copyright (c) 2026 PDFjet Software</Copyright>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Built with the fonts, -p:PDFjetFonts=true, the library has this
         constant too, which none of its code reads: a change of it compiles
         the DLL again, where a change of its resources alone would not. -->
    <DefineConstants Condition="'$(PDFjetFonts)' == 'true'">$(DefineConstants);PDFJET_FONTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="net/pdfjet/*.cs" />
    <Compile Include="net/pdfjet/Barcodes/*.cs" />
    <Compile Include="net/pdfjet/QRCode/*.cs" />
    <Compile Include="net/pdfjet/DataMatrix/*.cs" />
    <Compile Include="net/pdfjet/PDF417/*.cs" />
    <Compile Include="net/pdfjet/CoreFonts/*.cs" />
    <Compile Include="net/pdfjet/Fonts/*.cs" />
    <Compile Include="net/pdfjet/Encryption/*.cs" />
    <!-- The fonts PDFjet carries, which a font path is read from when there
         is no such file and SVG text is drawn in, and their licenses, as
         resources PDFjet.Fonts/Family/File, with / on Windows too: only when
         built with -p:PDFjetFonts=true, as for the NuGet package
         (package-nuget.sh). Otherwise the DLL is small and reads them from the
         folder resources/fonts, as in the repository and the release packages
         on GitHub. The font files and the licenses alone, not the Go and Swift
         files beside them. -->
    <EmbeddedResource Condition="'$(PDFjetFonts)' == 'true'" Include="resources/fonts/*/**/*.ttf;resources/fonts/*/**/*.otf;resources/fonts/*/**/*.txt;resources/fonts/*/**/LICENSE" LogicalName="PDFjet.Fonts/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
