{
    "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
    "metadata": [
        {
            "src": [
                {
                    "src": "..",
                    "files": [ "PDFjet.csproj" ]
                }
            ],
            "dest": "api"
        }
    ],
    "build": {
        "content": [
            {
                "files": [ "api/*.yml", "index.md", "toc.yml" ]
            },
            {
                "files": [ "PDFjet.md" ],
                "src": "redirects",
                "dest": "api"
            }
        ],
        "output": "../docs/dotnet",
        "template": [ "default", "modern", "template" ],
        "globalMetadata": {
            "_appName": "PDFjet",
            "_appLogoPath": "logo.svg",
            "_appTitle": "PDFjet for .NET",
            "_enableSearch": true
        }
    }
}
