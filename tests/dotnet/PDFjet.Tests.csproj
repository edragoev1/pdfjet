<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The unit tests of the C# port. The library sources are compiled into the
    test assembly, so the tests reach the internal classes (Decompressor,
    FastFloat, ...) as the Java tests reach the package-private ones, and
    PDFjet.csproj stays as it is. Run with ../../test-dotnet.sh.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>PDFjet.NET</RootNamespace>
    <!-- The library has a PNGImage.Main, so the entry point the test SDK generates is named. -->
    <StartupObject>AutoGeneratedProgram</StartupObject>
    <!-- Built with the fonts inside, by the second run of test-dotnet.sh, the
         tests know it: BundledFontsTest reads them from the assembly then. -->
    <DefineConstants Condition="'$(PDFjetFonts)' == 'true'">$(DefineConstants);PDFJET_FONTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../net/pdfjet/**/*.cs" />
    <Compile Include="*.cs" />
    <!-- The category table of the .NET Framework build, held to .NET 8's own. -->
    <Compile Include="../../net48/Compat/UnicodeCategories.cs" />
    <!-- The fonts PDFjet carries, which a font path is read from when there
         is no such file and SVG text is drawn in, and their licenses, as
         resources PDFjet.Fonts/Family/File, with / on Windows too: only when
         built with -p:PDFjetFonts=true, as for the NuGet package
         (package-nuget.sh). Otherwise the DLL is small and reads them from the
         folder resources/fonts, as in the repository and the release packages
         on GitHub. The font files and the licenses alone, not the Go and Swift
         files beside them. -->
    <EmbeddedResource Condition="'$(PDFjetFonts)' == 'true'" Include="../../resources/fonts/*/**/*.ttf;../../resources/fonts/*/**/*.otf;../../resources/fonts/*/**/*.txt;../../resources/fonts/*/**/LICENSE" LogicalName="PDFjet.Fonts/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
