# EditorConfig - https://editorconfig.org
# Four-space indentation everywhere. No tabs, no trailing whitespace.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt mandates tabs and has no option to do otherwise, so this repo is
# deliberately not gofmt-formatted. Turn OFF format-on-save for Go in your
# editor (GoLand: Settings > Tools > Actions on Save; VS Code: the gopls
# "editor.formatOnSave" setting for [go]) or it will put the tabs back.
[*.go]
indent_style = space
indent_size = 4

# Generated by their own tooling, which emits two spaces.
[*.{csproj,xml}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Example input fixtures. Their exact bytes are part of the expected output,
# so trailing whitespace and a missing final newline are both significant.
[data/**]
trim_trailing_whitespace = false
insert_final_newline = false

# Vendored third-party code (jQuery et al). Left exactly as shipped.
[docs/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = false
