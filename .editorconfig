# EditorConfig - https://editorconfig.org
# Tab indentation everywhere, displayed at 4 columns.
# Editors render tabs at whatever width they like; we standardize on 4.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt-compatible by construction: standard gofmt (default flags) is happy.
# GoLand: Settings > Editor > Code Style > Go > "Use tab character" enabled;
# tab_width above covers display size. No format-on-save exceptions needed.

# Generated by their own tooling, which emits two spaces.
[*.{csproj,xml}]
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Example input fixtures. Their exact bytes are part of the expected output,
# so trailing whitespace and a missing final newline are both significant.
[data/**]
trim_trailing_whitespace = false
insert_final_newline = false

# Vendored third-party code (jQuery et al). Left exactly as shipped.
[docs/**]
indent_style = unset
indent_size = unset
tab_width = unset
trim_trailing_whitespace = false
insert_final_newline = false
