# EditorConfig - https://editorconfig.org
# Spaces (4) for Java, C#, Swift. Tabs for Go (gofmt requirement),
# rendered at 4 columns so everything looks identical in the editor.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt mandates tabs, so Go files store tabs while everything else
# uses spaces. tab_width makes GoLand display each tab as 4 columns,
# matching the space-indented files visually.
[*.go]
indent_style = tab
tab_width = 4

# Generated by their own tooling, which emits two spaces.
[*.{csproj,xml}]
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Example input fixtures. Their exact bytes are part of the expected output,
# so trailing whitespace and a missing final newline are both significant.
[data/**]
trim_trailing_whitespace = false
insert_final_newline = false

# Vendored third-party code (jQuery et al). Left exactly as shipped.
[docs/**]
indent_style = unset
indent_size = unset
tab_width = unset
trim_trailing_whitespace = false
insert_final_newline = false
