<Project Sdk="Microsoft.NET.Sdk">
  <!-- The 57 examples of examples/, as they are, run one after the other on
       .NET Framework 4.8 against the net48 PDFjet.dll: see RunExamples.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>14</LangVersion>
    <StartupObject>RunExamples</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RunExamples.cs" />
    <Compile Include="../../examples/Example_*/Example_*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PDFjet">
      <HintPath>../bin/release/net48/PDFjet.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>
</Project>
