<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>               <!-- Specifies that it's a console app -->
    <TargetFramework>net8.0</TargetFramework>  <!-- Targets .NET 8 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <StartupObject>Example_52</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PDFjet">
      <HintPath>../../bin/release/net8.0/PDFjet.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- PDFjet.HarfBuzz, as a program adds the NuGet package beside PDFjet:
       TextBlock's HarfBuzz, found by its name -->
  <ItemGroup>
    <ProjectReference Include="../../nuget/harfbuzz/PDFjet.HarfBuzz.csproj" />
  </ItemGroup>
</Project>
